<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SimpleCompass</AssemblyName>
    <RootNamespace>SimpleCompass</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <AutoUnifyAssemblyReferences>true</AutoUnifyAssemblyReferences>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <!--
    Per-OS defaults for the game install and Mods folder - override either with
    -p:TimberbornDir=... / -p:TimberbornModsDir=... if yours lives somewhere else
    (e.g. a non-default Steam library, or GOG/Epic).
  -->
  <PropertyGroup>
    <_IsWindows>$([MSBuild]::IsOSPlatform('Windows'))</_IsWindows>
    <_IsMacOS>$([MSBuild]::IsOSPlatform('OSX'))</_IsMacOS>
  </PropertyGroup>

  <!-- Windows: native Steam install. -->
  <PropertyGroup Condition="'$(_IsWindows)' == 'true'">
    <TimberbornDir Condition="'$(TimberbornDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Timberborn</TimberbornDir>
    <TimberbornModsDir Condition="'$(TimberbornModsDir)' == ''">$(USERPROFILE)\Documents\Timberborn\Mods</TimberbornModsDir>
  </PropertyGroup>

  <!-- macOS: native Steam install. -->
  <PropertyGroup Condition="'$(_IsMacOS)' == 'true'">
    <TimberbornDir Condition="'$(TimberbornDir)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/Timberborn</TimberbornDir>
    <TimberbornModsDir Condition="'$(TimberbornModsDir)' == ''">$(HOME)/Documents/Timberborn/Mods</TimberbornModsDir>
  </PropertyGroup>

  <!-- Linux: Timberborn has no native Linux build, so this is a Steam Play/Proton prefix. -->
  <PropertyGroup Condition="'$(_IsWindows)' != 'true' And '$(_IsMacOS)' != 'true'">
    <TimberbornDir Condition="'$(TimberbornDir)' == ''">$(HOME)/.steam/debian-installation/steamapps/common/Timberborn</TimberbornDir>
    <TimberbornModsDir Condition="'$(TimberbornModsDir)' == ''">$(HOME)/.steam/debian-installation/steamapps/compatdata/1062090/pfx/drive_c/users/steamuser/Documents/Timberborn/Mods</TimberbornModsDir>
  </PropertyGroup>

  <PropertyGroup>
    <ManagedDir>$(TimberbornDir)/Timberborn_Data/Managed</ManagedDir>
    <ModDeployDir>$(TimberbornModsDir)/SimpleCompass</ModDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="source/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Bindito.Core">
      <HintPath>$(ManagedDir)/Bindito.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Timberborn.CameraSystem">
      <HintPath>$(ManagedDir)/Timberborn.CameraSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Timberborn.CoreUI">
      <HintPath>$(ManagedDir)/Timberborn.CoreUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Timberborn.SingletonSystem">
      <HintPath>$(ManagedDir)/Timberborn.SingletonSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Timberborn.UILayoutSystem">
      <HintPath>$(ManagedDir)/Timberborn.UILayoutSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(ManagedDir)/UnityEngine.UIElementsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Deploy straight into the live mod folder: the built DLL plus the manifest/thumbnail it needs alongside it. -->
  <Target Name="DeployMod" AfterTargets="Build">
    <ItemGroup>
      <ModFiles Include="$(OutDir)$(AssemblyName).dll" />
      <ModFiles Include="manifest.json" />
      <ModFiles Include="thumbnail.png" />
    </ItemGroup>
    <MakeDir Directories="$(ModDeployDir)" Condition="!Exists('$(ModDeployDir)')" />
    <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(ModDeployDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
